# Portal 659 — Variables de entorno
# Copiar a .env.local y completar

# === REQUERIDAS (Postgres plano + JWT) ===
DATABASE_URL=postgres://usuario:password@localhost:5432/portal659
JWT_SECRET=genera-una-clave-secreta-larga-y-aleatoria
NEXT_PUBLIC_SITE_URL=https://www.portal659.com.ar

# === OPCIONALES: almacenamiento de imágenes ===
# Ruta donde se guardan las imágenes subidas. Por defecto ./uploads
UPLOAD_DIR=/app/uploads

# === OPCIONALES: Mercado Pago (pagos online) ===
MP_ACCESS_TOKEN=your-mp-access-token
MP_PUBLIC_KEY=your-mp-public-key
MP_WEBHOOK_SECRET=your-mp-webhook-secret

# === OPCIONALES: Resend (emails transaccionales) ===
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=Portal 659 <noreply@tu-dominio.com>

# === OPCIONALES: Upstash Redis (rate limiting en producción) ===
UPSTASH_REDIS_REST_URL=your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# === OPCIONALES: Google Maps (geolocalización) ===
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-key

# === ASYNC: impresión térmica (app Portal Print en la red local) ===
# Secreto compartido entre el app y el relay `printbridge` (services/print-bridge).
# En el VPS se deja fijo en .env y el relay lo usa con el mismo valor.
PRINT_BRIDGE_SECRET=genera-un-secreto-aleatorio
# URL interna por la que el servidor conversa con el relay. No se expone.
PRINT_BRIDGE_URL=http://printbridge:8791