{
  "name": "portal-print-agent",
  "private": true,
  "version": "2.0.0",
  "description": "Agente de impresión para PC (relé WebSocket → impresora TCP ESC/POS) con ventana de configuración",
  "author": "Portal 659",
  "main": "src/main.js",
  "scripts": {
    "start": "node agent.mjs",
    "start:electron": "electron .",
    "test": "node test/relay-status.test.mjs && node test/local-server.test.mjs",
    "test:e2e": "node test/e2e.mjs",
    "build:exe": "electron-builder --win portable",
    "build:win": "electron-builder --win dir",
    "package:zip": "node scripts/package-zip.mjs",
    "build:win:zip": "npm run build:win && npm run package:zip"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ar.portal659.printagent",
    "productName": "Portal Print Agent",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    }
  }
}