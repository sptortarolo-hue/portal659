# Puerto del servicio wa-bot (HTTP + WS del relay)
PORT=8792

# URL interna del app Next de Portal 659 (endpoints /api/wa/*)
APP_URL=http://localhost:3000

# Secreto compartido con el app (WA_BOT_SECRET) para /api/wa/menu y /api/wa/order
WA_BOT_SECRET=

# PostgreSQL (para mapear token -> vendor y leer enabled). Misma DB que la app.
DATABASE_URL=

# Redis (Upstash) para el estado de conversación. Opcional: si falta, usa memoria.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# NVIDIA NIM para el NLU (OpenAI-compatible). Opcional: si falta, modo reglas.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct

# ————— Anti-ban (opcionales, hay defaults conservadores) —————
# Delay humano antes de responder (ms). Base + ~4ms por char del inbound.
WA_REPLY_DELAY_MIN_MS=1200
WA_REPLY_DELAY_MAX_MS=3500
# Gap entre replies múltiples de una misma interacción (ms).
WA_REPLY_GAP_MS=900
# Rate limits por comercio: al superarse el bot deja de responder (handoff al dueño).
WA_MAX_MSG_PER_HOUR=60
WA_MAX_MSG_PER_DAY=500
# Chats NUEVOS (primer contacto a un número distinto) por hora.
WA_MAX_NEW_CHATS_PER_HOUR=15