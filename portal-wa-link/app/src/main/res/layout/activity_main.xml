<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VPS (URL del relay)"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/vpsUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="wss://www.portal659.com.ar/wa"
        android:inputType="textUri" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Token de vinculación"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/token"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="vendor_wa_bots.token (desde tu panel)"
        android:inputType="text" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/start"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Iniciar" />

        <Button
            android:id="@+id/stop"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Detener" />

        <Button
            android:id="@+id/reset"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Re-escanear" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Estado: Detenido"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/pairing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Actualizar estado" />

    <!-- Visor de log: últimas líneas del proceso relay (diagnóstico) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="16dp"
        android:background="#202020"
        android:padding="6dp">

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#AAFFB0"
            android:textSize="9sp"
            android:typeface="monospace"
            android:text="(log aparentará acá)" />
    </ScrollView>

    <!-- Aviso: el QR del relay va al panel web; no se dibuja acá (imposible
         escanear la pantalla de este mismo celular con el WhatsApp de este
         mismo celular, y renderizarlo en main thread crasheaba la app). -->
    <TextView
        android:id="@+id/qrBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#FFF3CD"
        android:padding="12dp"
        android:text="📷 QR listo: abrí el panel web (/vendor/wa-bot) y escanealo desde WhatsApp en este celular → Dispositivos vinculados → Vincular dispositivo."
        android:textColor="#664D03"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="11sp"
        android:textColor="#888888"
        android:gravity="end" />
</LinearLayout>