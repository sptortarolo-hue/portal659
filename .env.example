# Portal 659 — Variables de entorno
# Copiar a .env.local y completar

# === REQUERIDAS ===
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=https://www.portal659.com.ar

# === OPCIONALES: Mercado Pago (pagos online) ===
MP_ACCESS_TOKEN=your-mp-access-token
MP_PUBLIC_KEY=your-mp-public-key
MP_WEBHOOK_SECRET=your-mp-webhook-secret

# === OPCIONALES: Resend (emails transaccionales) ===
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=Portal 659 <noreply@tu-dominio.com>

# === OPCIONALES: Upstash Redis (rate limiting en producción) ===
UPSTASH_REDIS_REST_URL=your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# === OPCIONALES: Google Maps (geolocalización) ===
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-key
