{
  "name": "portal-print",
  "version": "1.0.0",
  "private": true,
  "description": "Portal Print — puente de impresión ESC/POS para Portal 659 (Android)",
  "type": "module",
  "scripts": {
    "build": "npm run build:web",
    "build:web": "esbuild src/main.ts --bundle --minify --outfile=www/main.js",
    "sync": "npm run build:web && npx cap sync android",
    "android:open": "npx cap open android",
    "add:android": "npx cap add android",
    "apk": "npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "portal-socket": "file:./portal-socket"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}